# ---------------------------------------------------------------------------
# agentic-rag-nest — copier en .env à la racine du repo
# ---------------------------------------------------------------------------

# --- AWS / Bedrock -----------------------------------------------------------
# Sans clés ici, la chaîne AWS standard est utilisée (~/.aws/credentials via `aws configure`,
# SSO, rôle IAM). Vérifier : aws sts get-caller-identity
AWS_REGION=eu-west-3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Modèles : IDs à vérifier dans la console Bedrock de TA région (Model catalog).
# Lister : aws bedrock list-foundation-models --region $AWS_REGION --query "modelSummaries[].modelId" --output text | tr '\t' '\n'
# Les modèles Claude récents passent par un inference profile (préfixe eu. / us. / global.).
LLM_PROVIDER=bedrock                       # bedrock | mistral | azure
MODEL_ID=mistral.mistral-large-2407-v1:0   # générateur à outils
MODEL_SMALL_ID=mistral.mistral-small-2402-v1:0  # vérificateur de pertinence, routeur

EMBEDDING_PROVIDER=bedrock                 # bedrock | mistral
EMBEDDING_MODEL_ID=cohere.embed-multilingual-v3   # ou amazon.titan-embed-text-v2:0

RERANK_PROVIDER=bedrock                    # bedrock | cohere | none
RERANK_MODEL_ID=cohere.rerank-v3-5:0       # ou amazon.rerank-v1:0

# Juge de l'éval : le garder CONSTANT d'un run à l'autre. Par défaut le juge du projet Python.
JUDGE_PROVIDER=mistral
JUDGE_MODEL_ID=mistral-large-latest

# --- Autres fournisseurs (optionnels) ----------------------------------------------
MISTRALAI_API_KEY=                         # juge de l'éval + OCR des PDF uploadés
# COHERE_API_KEY=                          # si RERANK_PROVIDER=cohere
# AZURE_RESOURCE_NAME=                     # si LLM_PROVIDER=azure (MODEL_ID = nom du déploiement)
# AZURE_API_KEY=

# --- Observabilité (Langfuse Cloud EU) ---------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Index -------------------------------------------------------------------------
VECTOR_STORE=memory                        # memory | opensearch
OPENSEARCH_URL=http://localhost:9200

# --- Ablations (true/false) --------------------------------------------------------
# GENERATOR_TOOLS_ENABLED=true
# RERANK_ENABLED=true
# DOCUMENT_ROUTING_ENABLED=true
# RELEVANCE_CHECK_ENABLED=true

PORT=3000
CORS_ORIGINS=http://localhost:8080
